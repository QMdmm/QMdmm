# SPDX-License-Identifier: AGPL-3.0-or-later
#
# QMdmm 6 - CMake package configuration (hand-written).
#
# Layout, deliberately mirroring how Qt ships its CMake packages:
#
#   QMdmm6Targets.cmake            generated by install(EXPORT) - never edit
#   QMdmm6Config.cmake             this file (expanded from .in)
#   QMdmm6ConfigVersion.cmake      hand-written shell
#   QMdmm6ConfigVersionImpl.cmake  hand-written, holds the version policy
#   QMdmm6ConfigExtras.cmake       hand-written, expanded from .cmake.in
#   QMdmm6Macros.cmake             hand-written, installed verbatim
#
# The "6" in QMdmm6 is the Qt generation this build links against, not the
# QMdmm product version. A Qt 7 flavour of QMdmm will install into
# <libdir>/cmake/QMdmm7/ and own the QMdmm7:: namespace, so both generations can
# be installed side by side. Version compatibility is therefore checked against
# the QMdmm product version (see QMdmm6ConfigVersionImpl.cmake).
#
#   find_package(QMdmm6 0.0.2 REQUIRED COMPONENTS Core Networking)

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# QMdmm's public headers include Qt headers, and the imported shared libraries
# link against these Qt modules, so they must be resolved before the targets are
# imported. Consumers may of course request further Qt modules of their own.
find_dependency(Qt6 6.7 REQUIRED COMPONENTS Core Network WebSockets)

include("${CMAKE_CURRENT_LIST_DIR}/QMdmm6Macros.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/QMdmm6Targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/QMdmm6ConfigExtras.cmake")

# Components map 1:1 onto imported targets. The dev6 package is only ever
# produced from a Qt 6 build, so all of them are expected to be present; report
# the truth instead of hardcoding TRUE so a packaging mistake surfaces here.
foreach (_qmdmm6_component IN LISTS QMdmm6_KNOWN_COMPONENTS)
    if (TARGET "${QMdmm6_COMPONENT_TARGET_${_qmdmm6_component}}")
        set("QMdmm6_${_qmdmm6_component}_FOUND" TRUE)
    else()
        set("QMdmm6_${_qmdmm6_component}_FOUND" FALSE)
    endif()
endforeach()

# Opt-out for projects that would rather not have the generation-free aliases.
if (NOT QMdmm6_NO_VERSIONLESS_TARGETS)
    qmdmm6_add_versionless_targets()
endif()

check_required_components(QMdmm6)
